# Copy to .env.local for local runs; set the same names in the Vercel project.

# ── model ─────────────────────────────────────────────────────────────────────
# Both set: the agent runs on OpenAI. Either missing: the scripted model.
OPENAI_API_KEY=
OPENAI_MODEL=
# Force the starting model: "openai" or "mock". The director can switch at runtime.
AGENT_MODEL=

# ── required on Vercel ───────────────────────────────────────────────────────
# Signs tool approvals. Generate with: openssl rand -base64 32
TOOL_APPROVAL_SECRET=
# Session state (Vercel Marketplace -> Upstash Redis). Without these the app
# refuses to start on a preview or production deploy.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (or KV_REST_API_URL / KV_REST_API_TOKEN, as the Vercel Marketplace integration names them)

# ── demo calendar ────────────────────────────────────────────────────────────
# The day the booked trip departs, YYYY-MM-DD. Default: tomorrow (UTC).
DEMO_DEPART=

# ── live follow-up actions ───────────────────────────────────────────────────
# "on" to actually send; anything else only logs.
LIVE_ACTIONS=
# The only addresses/numbers anything may be sent to, comma-separated.
NOTIFY_ALLOWLIST=
NOTIFY_EMAIL=
NOTIFY_SMS=
RESEND_API_KEY=
NOTIFY_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── the hotel, on file ───────────────────────────────────────────────────────
# Where refund requests go. In the demo both are team contacts, and both must
# be on NOTIFY_ALLOWLIST. The recorded hotel's real number is never dialled.
HOTEL_EMAIL=
HOTEL_PHONE=

# ── the live hotel call (Twilio -> OpenAI Realtime SIP) ──────────────────────
# "on" (with LIVE_ACTIONS=on) to place a real call; otherwise it is simulated.
LIVE_CALLS=
# The OpenAI project whose SIP endpoint the call is bridged to (proj_…).
OPENAI_PROJECT_ID=
# Signing secret of the project's webhook for realtime.call.incoming,
# pointed at https://<host>/api/voice/incoming (whsec_…).
OPENAI_WEBHOOK_SECRET=
# Optional: REALTIME_MODEL (default gpt-realtime), REALTIME_VOICE (default marin).

# ── payments ─────────────────────────────────────────────────────────────────
# Settlement replays recorded sandbox responses. If set, must be the sandbox.
PAYPAL_BASE_URL=
